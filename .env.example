# Configurações do Supabase
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-supabase
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-supabase

# Configurações do Gateway Vizzion Pay PIX
VIZZION_PAY_API_URL=https://app.vizzionpay.com.br/api/v1
VIZZION_PAY_AUTH_MODE=keys
VIZZION_PAY_PUBLIC_KEY=sua-chave-publica-vizzion
VIZZION_PAY_PRIVATE_KEY=sua-chave-privada-vizzion

# Porta do Servidor Backend Local
PORT=3001
