{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/affiliate",
      "destination": "/affiliate/index.html"
    },
    {
      "source": "/manager",
      "destination": "/manager/index.html"
    },
    {
      "source": "/manager/cadastro",
      "destination": "/manager/cadastro/index.html"
    },
    {
      "source": "/manager/cadastro/:path*",
      "destination": "/manager/cadastro/index.html"
    }
  ]
}
